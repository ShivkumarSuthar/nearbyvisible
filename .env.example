# Google Cloud key with "Places API (New)" and "PageSpeed Insights API" enabled.
# Put the real value in .env.local (never commit it). On Vercel: Project > Settings > Environment Variables.
GOOGLE_API_KEY=

# Website forms email leads through Resend (resend.com).
RESEND_API_KEY=
LEAD_EMAIL_TO=nearbyvisible@gmail.com
# Until you verify your own domain in Resend, keep the default sender (onboarding@resend.dev).
# LEAD_EMAIL_FROM=NearbyVisible <hello@yourdomain.com>

# AI visibility check on /check. Free key: https://aistudio.google.com/apikey
# Uses Gemini with Google Search grounding. If the free quota runs out, that part of the report says so and the rest still works.
GEMINI_API_KEY=
# Optional. Defaults to the "gemini-flash-latest" alias.
# GEMINI_MODEL=gemini-flash-latest

# Meta (Facebook/Instagram) Pixel for ads. Events Manager > Data sources > your pixel ID (numbers only).
NEXT_PUBLIC_META_PIXEL_ID=
