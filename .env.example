# Copy to .env.local (and add the same values in Vercel → Settings → Environment Variables).
# Never commit real values.

# Public address of the site, e.g. https://nearbyvisible.in
NEXT_PUBLIC_SITE_URL=

# Free Visibility Score: Google Places API (New) + PageSpeed Insights, and Gemini for the AI check
GOOGLE_API_KEY=
GEMINI_API_KEY=
# Optional, any long random string. Signs audit/AI tokens.
AUDIT_SIGNING_SECRET=

# Email with Resend (resend.com, free 3,000/month) from your own domain. When both are set, ALL emails
# (team leads and customer reports) go through Resend and the EmailJS settings below are not used.
# Verify the domain in Resend first. Example: EMAIL_FROM=NearbyVisible <report@yourdomain.in>
RESEND_API_KEY=
EMAIL_FROM=

# Leads by email (EmailJS), used when Resend is not set up
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
LEAD_EMAIL_TO=

# Meta Pixel (only loads after the visitor accepts cookies). Leave empty to turn off.
NEXT_PUBLIC_META_PIXEL_ID=

# Bot protection: Cloudflare Turnstile (free). On only when BOTH are set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (free plan): shared rate limits, and saved reports (30 days) behind the email/WhatsApp link.
# Without these, limits are per server instance and reports are not saved.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Customer report by email without Resend: a second EmailJS template whose "To Email" is {{to_email}}.
# Template variables: subject, business, score, link, summary.
EMAILJS_REPORT_TEMPLATE_ID=

# WhatsApp report bot (Meta WhatsApp Cloud API, free replies). The customer sends "Ref: NV-XXXXXX",
# the bot replies with the report link. Webhook URL: https://YOUR-DOMAIN/api/whatsapp
# Without these, the button opens a chat with the normal business number instead.
NEXT_PUBLIC_WHATSAPP_REPORT_NUMBER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Site-wide daily caps that protect the Google/Gemini bill (defaults shown)
FREE_CHECKS_PER_DAY=300
LEADS_PER_DAY=500
